  profile            Profile?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  loyaltyTransactions ShopLoyaltyTransaction[]
  logs               ShopOrderLog[]

  @@index([userId])
  @@index([status])
  @@index([email])
  @@map("shop_orders")
}

