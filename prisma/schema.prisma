generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Profile {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String   @unique @db.Uuid @map("user_id")
  email           String?
  username        String   @unique
  fullName        String?  @map("full_name")
  avatarUrl       String?  @map("avatar_url")
  bio             String?
  location        String?
  growingZone     String?  @map("growing_zone")
  growingType     String?  @map("growing_type")
  experienceLevel String?  @map("experience_level")
  role            String   @default("user")
  points          Int      @default(0)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  posts                Post[]
  comments             PostComment[]
  postLikes            PostLike[]
  savedPosts           SavedPost[]
  followers            Follow[]          @relation("Following")
  following            Follow[]          @relation("Follower")
  plantTips            PlantTip[]
  gardenDiaries        GardenDiary[]
  reminders            Reminder[]
  questions            Question[]
  answers              Answer[]
  createdGroups        Group[]
  groupMemberships     GroupMember[]
  seedExchanges        SeedExchange[]
  challengeParticipants ChallengeParticipant[]
  pointTransactions    PointTransaction[]
  reports              Report[]           @relation("Reporter")
  handledReports       Report[]           @relation("Handler")
  moderatorPermissions ModeratorPermission?
  calendarSuggestions  GardenCalendar[]
  answerLikes          AnswerLike[]
  plantDiagnoses       PlantDiagnosis[]
  diagnosisComments    DiagnosisComment[]
  challengeEntries     ChallengeEntry[]
  challengeComments    ChallengeComment[]
  subscription         Subscription?
  weeklyTasks          WeeklyTask[]
  shopOrders              ShopOrder[]
  shopCustomer            ShopCustomer?
  shopNewsletterSubs      ShopNewsletterSubscriber[]
  shopReviews             ShopProductReview[]
  loyaltyTransactions     ShopLoyaltyTransaction[]
  loyaltyBalance          ShopLoyaltyBalance?
  plantIdentifications    PlantIdentification[]
  plantHealthChecks       PlantHealthCheck[]
  aiUsage                 AiUsage[]

  @@map("profiles")
}

model ModeratorPermission {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId               String   @unique @db.Uuid @map("user_id")
  canModeratePosts     Boolean  @default(false) @map("can_moderate_posts")
  canModerateComments  Boolean  @default(false) @map("can_moderate_comments")
  canBanUsers          Boolean  @default(false) @map("can_ban_users")
  canManageReports     Boolean  @default(false) @map("can_manage_reports")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("moderator_permissions")
}

model Post {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String   @db.Uuid @map("user_id")
  title        String
  content      String
  imageUrl     String?  @map("image_url")
  category     String?
  postType     String   @default("discussion") @map("post_type")
  likesCount   Int      @default(0) @map("likes_count")
  commentsCount Int     @default(0) @map("comments_count")
  isFeatured   Boolean  @default(false) @map("is_featured")
  status       String   @default("published")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  author   Profile       @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments PostComment[]
  likes    PostLike[]
  saved    SavedPost[]

  @@index([userId])
  @@index([category])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@map("posts")
}

model PostComment {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  postId     String   @db.Uuid @map("post_id")
  userId     String   @db.Uuid @map("user_id")
  content    String
  parentId   String?  @db.Uuid @map("parent_id")
  likesCount Int      @default(0) @map("likes_count")
  status     String   @default("published")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  post    Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  author  Profile       @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent  PostComment?  @relation("Replies", fields: [parentId], references: [id])
  replies PostComment[] @relation("Replies")

  @@index([postId])
  @@index([userId])
  @@map("post_comments")
}

model PostLike {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  postId    String   @db.Uuid @map("post_id")
  userId    String   @db.Uuid @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  post    Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@map("post_likes")
}

model SavedPost {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  postId    String   @db.Uuid @map("post_id")
  userId    String   @db.Uuid @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  post    Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@map("saved_posts")
}

model Follow {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  followerId  String   @db.Uuid @map("follower_id")
  followingId String   @db.Uuid @map("following_id")
  createdAt   DateTime @default(now()) @map("created_at")

  follower  Profile @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following Profile @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
  @@map("follows")
}

model Plant {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  slug           String   @unique
  latinName      String?  @map("latin_name")
  imageUrl       String?  @map("image_url")
  category        String?  @map("category")
  difficultyLevel String?  @map("difficulty_level")
  sowingPeriod    String?  @map("sowing_period")
  plantingPeriod String?  @map("planting_period")
  harvestPeriod  String?  @map("harvest_period")
  sunRequirement String?  @map("sun_requirement")
  wateringNeeds  String?  @map("watering_needs")
  soilType        String?  @map("soil_type")
  fertilizerNeeds String?  @map("fertilizer_needs")
  soilPreparation String?  @map("soil_preparation")
  locationNotes   String?  @map("location_notes")
  commonProblems  String?  @map("common_problems")
  description     String?
  seoTitle       String?  @map("seo_title")
  seoDescription String?  @map("seo_description")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  tips            PlantTip[]
  diaries         GardenDiary[]
  identifications PlantIdentification[]
  healthChecks        PlantHealthCheck[]
  recommendationRules ShopProductRecommendationRule[]
  reminders    Reminder[]
  diagnoses    PlantDiagnosis[]
  productLinks ShopProductPlant[]
  homeSections ShopHomeSection[]

  @@index([slug])
  @@map("plants")
}

model PlantTip {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  plantId   String   @db.Uuid @map("plant_id")
  userId    String   @db.Uuid @map("user_id")
  content   String
  imageUrl  String?  @map("image_url")
  status    String   @default("published")
  createdAt DateTime @default(now()) @map("created_at")

  plant  Plant   @relation(fields: [plantId], references: [id], onDelete: Cascade)
  author Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([plantId])
  @@index([userId])
  @@map("plant_tips")
}

model GardenCalendar {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title           String
  slug            String   @unique
  month           Int
  category        String?
  description     String?
  taskType        String?  @map("task_type")
  growingZone     String?  @map("growing_zone")
  growingType     String?  @map("growing_type")
  isUserSuggested Boolean  @default(false) @map("is_user_suggested")
  suggestedBy     String?  @db.Uuid @map("suggested_by")
  status          String   @default("published")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  suggester Profile? @relation(fields: [suggestedBy], references: [id], onDelete: SetNull)

  @@index([month])
  @@map("garden_calendar")
}

model GardenDiary {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String    @db.Uuid @map("user_id")
  plantId         String?   @db.Uuid @map("plant_id")
  customPlantName String?   @map("custom_plant_name")
  title           String
  notes           String?
  imageUrl        String?   @map("image_url")
  sowingDate      DateTime? @map("sowing_date") @db.Date
  plantingDate    DateTime? @map("planting_date") @db.Date
  harvestDate     DateTime? @map("harvest_date") @db.Date
  status          String    @default("growing")
  isPublic        Boolean   @default(false) @map("is_public")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  owner     Profile      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plant     Plant?       @relation(fields: [plantId], references: [id], onDelete: SetNull)
  reminders Reminder[]
  entries   DiaryEntry[]

  @@index([userId])
  @@map("garden_diary")
}

model DiaryEntry {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  diaryId   String   @db.Uuid @map("diary_id")
  type      String   // sowing | planting | harvest | note | observation | watering | fertilizing
  date      DateTime @db.Date
  notes     String?
  imageUrl  String?  @map("image_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  diary GardenDiary @relation(fields: [diaryId], references: [id], onDelete: Cascade)

  @@index([diaryId])
  @@map("diary_entries")
}

model Reminder {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String   @db.Uuid @map("user_id")
  diaryId        String?  @db.Uuid @map("diary_id")
  plantId        String?  @db.Uuid @map("plant_id")
  reminderType   String   @map("reminder_type")
  title          String
  description    String?
  dueDate        DateTime @map("due_date")
  repeatInterval String?  @map("repeat_interval")
  isCompleted    Boolean  @default(false) @map("is_completed")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  owner Profile      @relation(fields: [userId], references: [id], onDelete: Cascade)
  diary GardenDiary? @relation(fields: [diaryId], references: [id], onDelete: Cascade)
  plant Plant?       @relation(fields: [plantId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("reminders")
}

model Question {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String   @db.Uuid @map("user_id")
  title        String
  slug         String   @unique
  content      String
  imageUrl     String?  @map("image_url")
  category     String?
  status       String   @default("open")
  viewsCount   Int      @default(0) @map("views_count")
  answersCount Int      @default(0) @map("answers_count")
  bestAnswerId String?  @db.Uuid @map("best_answer_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  author     Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers    Answer[]
  bestAnswer Answer?  @relation("BestAnswer", fields: [bestAnswerId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([slug])
  @@map("questions")
}

model Answer {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  questionId   String   @db.Uuid @map("question_id")
  userId       String   @db.Uuid @map("user_id")
  content      String
  imageUrl     String?  @map("image_url")
  likesCount   Int      @default(0) @map("likes_count")
  isBestAnswer Boolean  @default(false) @map("is_best_answer")
  status       String   @default("published")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  question      Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  author        Profile     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bestAnswerFor Question[]  @relation("BestAnswer")
  likes         AnswerLike[]

  @@index([questionId])
  @@index([userId])
  @@map("answers")
}

model AnswerLike {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  answerId  String   @db.Uuid @map("answer_id")
  userId    String   @db.Uuid @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  answer  Answer  @relation(fields: [answerId], references: [id], onDelete: Cascade)
  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([answerId, userId])
  @@map("answer_likes")
}

model Group {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  slug        String   @unique
  description String?
  location    String?
  category    String   @default("interest")   // "region" | "interest"
  groupType   String   @default("public") @map("group_type")  // "public" | "private"
  imageUrl    String?  @map("image_url")
  createdBy   String   @db.Uuid @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  creator Profile       @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  members GroupMember[]

  @@index([slug])
  @@index([category])
  @@map("groups")
}

model GroupMember {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  groupId   String   @db.Uuid @map("group_id")
  userId    String   @db.Uuid @map("user_id")
  role      String   @default("member")
  createdAt DateTime @default(now()) @map("created_at")

  group   Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
  @@map("group_members")
}

model SeedExchange {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String   @db.Uuid @map("user_id")
  title        String
  slug         String   @unique
  description  String?
  variety      String?                              // Specifik sort, t.ex. "San Marzano"
  exchangeType String   @default("trade") @map("exchange_type")  // trade | give | sell | wanted
  category     String?                              // Frön | Plantor | Sticklingar | Verktyg | Tillbehör
  location     String?
  price        Int?                                 // Pris i SEK (endast för sell)
  imageUrl     String?  @map("image_url")
  status       String   @default("active")          // active | reserved | closed
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  owner Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([category])
  @@index([exchangeType])
  @@map("seed_exchanges")
}

model Challenge {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String
  slug        String    @unique
  description String?
  rules       String?
  category    String?
  imageUrl    String?   @map("image_url")
  startDate   DateTime? @map("start_date")
  endDate     DateTime? @map("end_date")
  status      String    @default("upcoming")  // upcoming | active | ended
  published   Boolean   @default(false)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  participants ChallengeParticipant[]
  entries      ChallengeEntry[]

  @@index([slug])
  @@index([status])
  @@map("challenges")
}

model ChallengeParticipant {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  challengeId String   @db.Uuid @map("challenge_id")
  userId      String   @db.Uuid @map("user_id")
  joinedAt    DateTime @default(now()) @map("joined_at")

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  profile   Profile   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([challengeId, userId])
  @@index([userId])
  @@map("challenge_participants")
}

model ChallengeEntry {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  challengeId String   @db.Uuid @map("challenge_id")
  profileId   String   @db.Uuid @map("profile_id")
  imageUrl    String   @map("image_url")
  caption     String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  challenge Challenge          @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  profile   Profile            @relation(fields: [profileId], references: [id], onDelete: Cascade)
  comments  ChallengeComment[]

  @@index([challengeId])
  @@index([profileId])
  @@map("challenge_entries")
}

model ChallengeComment {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entryId   String   @db.Uuid @map("entry_id")
  profileId String   @db.Uuid @map("profile_id")
  content   String
  createdAt DateTime @default(now()) @map("created_at")

  entry   ChallengeEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  profile Profile        @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([entryId])
  @@map("challenge_comments")
}

model Guide {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title          String
  slug           String   @unique
  excerpt        String?
  content        String?
  imageUrl       String?  @map("image_url")
  category       String?
  difficultyLevel String? @map("difficulty_level")
  seoTitle       String?  @map("seo_title")
  seoDescription String?  @map("seo_description")
  published      Boolean  @default(false)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([slug])
  @@map("guides")
}

model KnowledgeArticle {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title          String
  slug           String   @unique
  excerpt        String?
  content        String?
  category       String?
  imageUrl       String?  @map("image_url")
  seoTitle       String?  @map("seo_title")
  seoDescription String?  @map("seo_description")
  published      Boolean  @default(false)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([slug])
  @@map("knowledge_articles")
}

model PlantDiagnosis {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId      String    @db.Uuid @map("profile_id")
  imageUrl       String    @map("image_url")
  description    String
  plantName      String?   @map("plant_name")
  plantId        String?   @db.Uuid @map("plant_id")
  problemType    String?   @map("problem_type")
  status         String    @default("open")
  // AI-fält – förberedda för framtida integration
  aiDiagnosis    String?   @map("ai_diagnosis")
  aiConfidence   Float?    @map("ai_confidence")
  aiModelVersion String?   @map("ai_model_version")
  aiProcessedAt  DateTime? @map("ai_processed_at")
  isPublic       Boolean   @default(true) @map("is_public")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  profile  Profile           @relation(fields: [profileId], references: [id], onDelete: Cascade)
  plant    Plant?            @relation(fields: [plantId], references: [id])
  comments DiagnosisComment[]

  @@index([profileId])
  @@index([status])
  @@index([problemType])
  @@map("plant_diagnoses")
}

model DiagnosisComment {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  diagnosisId String   @db.Uuid @map("diagnosis_id")
  profileId   String   @db.Uuid @map("profile_id")
  content     String
  isExpert    Boolean  @default(false) @map("is_expert")
  isSolution  Boolean  @default(false) @map("is_solution")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  diagnosis PlantDiagnosis @relation(fields: [diagnosisId], references: [id], onDelete: Cascade)
  profile   Profile        @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([diagnosisId])
  @@index([profileId])
  @@map("diagnosis_comments")
}

model GlossaryTerm {
  id               String   @id @default(dbgenerated("gen_random_uuid()::text"))
  term             String
  slug             String   @unique
  shortDescription String?  @map("short_description")
  fullDescription  String?  @map("full_description")
  imageUrl         String?  @map("image_url")
  category         String?
  relatedSlugs     String[] @map("related_slugs")
  seoTitle         String?  @map("seo_title")
  seoDescription   String?  @map("seo_description")
  published        Boolean  @default(true)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@index([slug])
  @@map("glossary_terms")
}

model Banner {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title            String
  imageUrl         String?   @map("image_url")
  linkUrl          String    @map("link_url")
  placement        String
  isActive         Boolean   @default(true) @map("is_active")
  clicksCount      Int       @default(0) @map("clicks_count")
  impressionsCount Int       @default(0) @map("impressions_count")
  startDate        DateTime? @map("start_date")
  endDate          DateTime? @map("end_date")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  clicks BannerClick[]

  @@map("banners")
}

model BannerClick {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bannerId  String   @db.Uuid @map("banner_id")
  userId    String?  @db.Uuid @map("user_id")
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")

  banner Banner @relation(fields: [bannerId], references: [id], onDelete: Cascade)

  @@index([bannerId])
  @@index([userId])
  @@map("banner_clicks")
}

model PointTransaction {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String   @db.Uuid @map("user_id")
  points        Int
  reason        String
  referenceType String?  @map("reference_type")
  referenceId   String?  @db.Uuid @map("reference_id")
  createdAt     DateTime @default(now()) @map("created_at")

  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("point_transactions")
}

model Report {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reporterId String   @db.Uuid @map("reporter_id")
  targetType String   @map("target_type")
  targetId   String   @db.Uuid @map("target_id")
  reason     String
