model ShopCategory {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  slug           String   @unique
  description    String?
  imageUrl       String?  @map("image_url")
  seoTitle       String?  @map("seo_title")
  seoDescription String?  @map("seo_description")
  seoText        String?  @map("seo_text")
  sortOrder      Int      @default(0) @map("sort_order")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  products     ShopProduct[]
  homeSections ShopHomeSection[]
  navItems     ShopNavItem[]

  @@index([slug])
  @@map("shop_categories")
}

model ShopNavItem {
  id         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  label      String
  href       String
  categoryId String?       @db.Uuid @map("category_id")
  sortOrder  Int           @default(0) @map("sort_order")
  isActive   Boolean       @default(true) @map("is_active")
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  category   ShopCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([sortOrder])
  @@map("shop_nav_items")
}

model ShopProduct {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String
  slug             String   @unique
  description      String?
  shortDescription String?  @map("short_description")
  price            Int      // öre (SEK * 100)
  compareAtPrice   Int?     @map("compare_at_price")
  sku              String?  @unique
  stockQuantity    Int      @default(0) @map("stock_quantity")
  imageUrl         String?  @map("image_url")
  galleryImages    String[] @map("gallery_images")
  categoryId       String?  @db.Uuid @map("category_id")
  difficultyLevel  String?  @map("difficulty_level")
  growingType      String?  @map("growing_type")
  isFeatured       Boolean  @default(false) @map("is_featured")
  isActive         Boolean  @default(true) @map("is_active")
  seoTitle         String?  @map("seo_title")
  seoDescription   String?  @map("seo_description")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  category     ShopCategory?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  orderItems   ShopOrderItem[]
  plantLinks       ShopProductPlant[]
  reviews          ShopProductReview[]
  recommendationRules ShopProductRecommendationRule[]

  @@index([slug])
  @@index([categoryId])
  @@map("shop_products")
}

model ShopProductPlant {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId    String   @db.Uuid @map("product_id")
  plantId      String   @db.Uuid @map("plant_id")
  relationType String   @default("related") @map("relation_type")
  createdAt    DateTime @default(now()) @map("created_at")

  product ShopProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  plant   Plant       @relation(fields: [plantId], references: [id], onDelete: Cascade)

  @@unique([productId, plantId])
  @@index([productId])
  @@index([plantId])
  @@map("shop_product_plants")
}

model ShopOrder {
  id                      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                  String?  @db.Uuid @map("user_id")
  email                   String
  fullName                String   @map("full_name")
  phone                   String?
  shippingAddress         Json     @map("shipping_address")
  billingAddress          Json?    @map("billing_address")
  subtotal                Int      // öre
  discountAmount          Int      @default(0) @map("discount_amount")
  shippingAmount          Int      @default(0) @map("shipping_amount")
  totalAmount             Int      @map("total_amount")
  currency                String   @default("SEK")
  status                  String   @default("pending")
  stripePaymentIntentId   String?  @unique @map("stripe_payment_intent_id")
  stripeCheckoutSessionId String?  @unique @map("stripe_checkout_session_id")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

